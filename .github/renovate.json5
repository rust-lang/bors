{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>rust-lang/renovate",
    "docker:disable",
  ],
  "lockFileMaintenance": {
    "extends": ["schedule:monthly"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "extends": ["schedule:monthly"]
    },
    {
      "matchManagers": ["npm"],
      "extends": ["schedule:monthly"]
    },
    {
      // Do not update the pinned Rust toolchain version in GHA workflows,
      // we update it manually together with the MSRV.
      "matchManagers": ["github-actions"],
      "matchDepNames": ["rust"],
      "enabled": false
    }
  ],
}

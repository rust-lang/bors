  "query": "\n        SELECT\n            pr.number AS number,\n            rm.rolled_up_sha AS head_sha,\n            rm.rolled_up_merge_sha AS merge_sha,\n            rm.unroll_state as \"unroll_state: UnrollState\"\n        FROM rollup_member rm\n        JOIN pull_request AS pr ON pr.id = rm.member\n        WHERE rm.rollup = $1\n            ",
